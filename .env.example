# ═══════════════════════════════════════════════════════════════
# OpenClaw / FishIntel Configuration
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# Database
DATABASE_URL=sqlite:///data/openclaw.db  # or postgresql://user:pass@localhost:5432/openclaw

# Authentication (REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
FISHINTEL_JWT_SECRET=

# CORS (comma-separated origins)
FISHINTEL_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# BarentsWatch (register at https://www.barentswatch.no/minside/apitilgang)
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_INVESTOR=

# MET.no Frost API (register at https://frost.met.no/)
MET_FROST_CLIENT_ID=

# Copernicus Marine Service (register at https://marine.copernicus.eu/)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Sentinel Hub (register at https://www.sentinel-hub.com/)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# LLM Provider
LLM_PROVIDER=anthropic  # or openai, openrouter
ANTHROPIC_API_KEY=

# Figma design-token pipeline (optional — only needed for pull/push modes)
# Generate token at https://www.figma.com/developers/api#access-tokens (scope: Variables read+write)
# File key is the part after /file/ in the Figma URL
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=
