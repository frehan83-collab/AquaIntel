# ═══════════════════════════════════════════════════════════════
# AquaIntel / FishIntel Configuration
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════════════

# Database
DATABASE_URL=sqlite:///data/aquaintel.db  # or postgresql://user:pass@localhost:5432/aquaintel

# Authentication (REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
FISHINTEL_JWT_SECRET=

# CORS (comma-separated origins)
FISHINTEL_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# BarentsWatch (register at https://www.barentswatch.no/minside/apitilgang)
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_INVESTOR=
# Optional: canonical plan ids are created/found automatically by
# core/billing/stripe_catalog.ensure_catalog() — set these only to pin existing
# prices. Self-serve plans: free/operator/professional/enterprise/investor/intelligence
# (the `data` tier is licensed per contract and never self-serve).
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_INTELLIGENCE=
# Dev/CI money-path testing: simulates a Stripe event without credentials.
# Refused when FISHINTEL_ENV=production. If set, callers must send the same value
# in the X-Mock-Billing-Token header.
FISHINTEL_MOCK_BILLING_TOKEN=

# MET.no Frost API (register at https://frost.met.no/)
MET_FROST_CLIENT_ID=

# Copernicus Marine Service (register at https://marine.copernicus.eu/)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Sentinel Hub (register at https://www.sentinel-hub.com/)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# LLM Provider
LLM_PROVIDER=anthropic  # or openai, openrouter, gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Firecrawl (research/scraping helper: scripts/firecrawl_research.py)
FIRECRAWL_API_KEY=
